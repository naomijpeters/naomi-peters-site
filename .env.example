# =============================================================================
# Naomi Peters — website configuration
# Copy this file to `.env.local` for local development, and paste the same
# names/values into Vercel → Project → Settings → Environment Variables.
# Leave a value blank and the site falls back to a friendly "being set up" page
# instead of a broken link. After changing values on Vercel, redeploy.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Your live domain, no trailing slash. Used for canonical URLs, sitemap, social cards.
NEXT_PUBLIC_SITE_URL=https://www.makecollegepayoff.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Booking (Calendly) -------------------------------------------------------
# Paste the full event link, e.g. https://calendly.com/your-name/free-call
NEXT_PUBLIC_CALENDLY_FREE_CALL_URL=
NEXT_PUBLIC_CALENDLY_STRATEGY_URL=
NEXT_PUBLIC_CALENDLY_FIT_CALL_URL=

# --- Payments (Stripe-hosted Payment Links) -----------------------------------
# e.g. https://buy.stripe.com/xxxxxxxx — never paste secret keys here.
NEXT_PUBLIC_STRIPE_STRATEGY_PACK_URL=
NEXT_PUBLIC_STRIPE_INTENSIVE_URL=
NEXT_PUBLIC_STRIPE_ROI_BLUEPRINT_URL=
NEXT_PUBLIC_STRIPE_PAYMENT_PLAN_URL=

# --- Optional PayPal (future; not required) -----------------------------------
NEXT_PUBLIC_PAYPAL_STRATEGY_PACK_URL=
NEXT_PUBLIC_PAYPAL_INTENSIVE_URL=
NEXT_PUBLIC_PAYPAL_ROI_BLUEPRINT_URL=

# --- After purchase (/welcome page) -------------------------------------------
# Intake questionnaire (Google Form, Typeform, Tally…) and the Calendly link
# paying clients use to schedule their sessions.
INTAKE_FORM_URL=
CLIENT_SCHEDULING_URL=

# --- Analytics ----------------------------------------------------------------
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX. Blank = no analytics loaded.
NEXT_PUBLIC_GA_ID=

# --- Email list (College ROI Starter Kit) -------------------------------------
# Choose one: kit | beehiiv | mailchimp   (blank = signup not connected yet)
EMAIL_PROVIDER=
# Kit (formerly ConvertKit) — Settings → Developer → API key (v4), and the Form ID
KIT_API_KEY=
KIT_FORM_ID=
# Beehiiv — Settings → Integrations → API
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# Mailchimp — Account → Extras → API keys; Audience → Settings → Audience ID
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Optional: a direct link to the guide shown after a successful signup
NEXT_PUBLIC_LEAD_MAGNET_URL=

# --- Contact & speaking forms -------------------------------------------------
# Any service that accepts a JSON POST (Formspree, Basin, Getform, a Zapier/Make webhook).
# e.g. https://formspree.io/f/abcdwxyz
FORM_ENDPOINT=
# Optional: send speaking inquiries somewhere different
SPEAKING_FORM_ENDPOINT=

# --- Legal --------------------------------------------------------------------
# Business/legal name and state shown on Terms & Privacy pages.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Naomi Peters
NEXT_PUBLIC_LEGAL_STATE=
